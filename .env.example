# --- Supabase (wymagane do logowania i zapisu danych) ---
# Project Settings → API (lub "Connect") w panelu Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
# Klucz publiczny ("publishable", sb_publishable_...) lub starszy "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Publiczny adres aplikacji (linki w e-mailach i potwierdzenie rejestracji).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Przypomnienia e-mail (opcjonalne; bez nich przypomnienia nie są wysyłane) ---
# SEKRET: klucz "secret" (sb_secret_...) lub "service_role". Tylko serwer — nigdy z prefiksem NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Losowy ciąg, np. `openssl rand -hex 32`. Vercel Cron wysyła go w nagłówku Authorization.
CRON_SECRET=
# Klucz API z https://resend.com oraz zweryfikowany nadawca.
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Opłacik <przypomnienia@twojadomena.pl>"

# --- Automatyczne dodawanie z e-maili (opcjonalne; wymaga też SUPABASE_SECRET_KEY) ---
# Szablon prywatnego adresu użytkownika; {token} zostanie podmieniony.
# Postmark Inbound: "<twój-inbound-hash>+{token}@inbound.postmarkapp.com", własna domena: "{token}@in.twojadomena.pl"
INBOUND_EMAIL_ADDRESS=
# Hasło Basic Auth w adresie webhooka: https://oplacik:<SEKRET>@twojadomena.pl/api/inbound-email
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- Powiadomienia push w aplikacji na telefon (opcjonalne) ---
# Wygeneruj raz: `npx web-push generate-vapid-keys`. Klucz publiczny trafia do przeglądarki, prywatny jest SEKRETEM.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt dla usług push, domyślnie mailto:<NEXT_PUBLIC_CONTACT_EMAIL>.
VAPID_SUBJECT=

# --- Logowanie przez Google (opcjonalne) ---
# Ustaw "true" dopiero po włączeniu dostawcy Google w Supabase (Authentication → Sign In / Providers).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=

# --- Premium / płatności Stripe (opcjonalne; wymaga też SUPABASE_SECRET_KEY) ---
# Dopóki nie ustawisz "true", Premium jest pokazywane jako „wkrótce” (bez zakupu, z listą chętnych).
NEXT_PUBLIC_PREMIUM_SALES_ENABLED=
# Adresy e-mail (po przecinku) kont, które widzą /panel/admin — listę chętnych na Premium i wysyłkę powiadomień o starcie.
ADMIN_EMAILS=
# Developers → API keys (sk_live_... lub sk_test_... do testów).
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://twojadomena.pl/api/stripe/webhook → Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# --- Dane do regulaminu i polityki prywatności (opcjonalne — nadpisują wartości domyślne z src/lib/legal.ts) ---
# Sprzedawca / administrator danych (domyślnie: Olivier Cisoń).
LEGAL_OPERATOR_NAME=
# Adres do doręczeń, np. "ul. Przykładowa 1, 00-001 Warszawa".
LEGAL_OPERATOR_ADDRESS=
# NIP — tylko jeśli sprzedawca prowadzi firmę.
LEGAL_OPERATOR_TAX_ID=
# E-mail kontaktowy w stopce, regulaminie i polityce prywatności (domyślnie: kontakt@oplacik.pl).
NEXT_PUBLIC_CONTACT_EMAIL=
