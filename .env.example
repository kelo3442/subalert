# --- Supabase (wymagane do logowania i zapisu danych) ---
# Project Settings → API (lub "Connect") w panelu Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
# Klucz publiczny ("publishable", sb_publishable_...) lub starszy "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Publiczny adres aplikacji (linki w e-mailach i potwierdzenie rejestracji).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Przypomnienia e-mail (opcjonalne; bez nich przypomnienia nie są wysyłane) ---
# SEKRET: klucz "secret" (sb_secret_...) lub "service_role". Tylko serwer — nigdy z prefiksem NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Losowy ciąg, np. `openssl rand -hex 32`. Vercel Cron wysyła go w nagłówku Authorization.
CRON_SECRET=
# Klucz API z https://resend.com oraz zweryfikowany nadawca.
RESEND_API_KEY=
REMINDER_FROM_EMAIL="SubAlert <przypomnienia@twojadomena.pl>"
